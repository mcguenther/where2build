# Grundstücks-Check Sachsen — backend configuration.
# Copy to .env and fill in. Every value below is a default; none has to be set
# except LLM_API_KEY, without which page extraction stays switched off.

# --- application ----------------------------------------------------------
# Browser origins allowed to call this API (JSON list). Vite dev + preview.
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
APP_CACHE_DIR=.cache
# Transitous requires a contact address in the User-Agent — put a real one here.
APP_USER_AGENT=GrundstuecksCheckSachsen/0.1 (+https://example.org; kontakt@example.org)
APP_HTTP_TIMEOUT_S=30

# --- ALKIS (GeoSN, cadastral parcels) -------------------------------------
ALKIS_WFS_URL=https://geodienste.sachsen.de/aaa/public_alkis/vereinf/wfs
ALKIS_VERSION=2.0.0
ALKIS_SRID=25833
ALKIS_MAX_FEATURES=200
ALKIS_POINT_BUFFER_M=1.0
ALKIS_CACHE_TTL_S=604800

# --- BORIS (land reference values) ----------------------------------------
# The endpoint carries the reference year; re-check it once a year.
BORIS_WMS_URL=https://www.landesvermessung.sachsen.de/fp/httpproxy/svcdep/wms/boris_2026
BORIS_LAYER=brw_2026
BORIS_CACHE_TTL_S=2592000

# --- MOTIS / Transitous (routing, geocoding) ------------------------------
# The public instance is for the prototype only: open source, non-commercial,
# light load. Point this at your own MOTIS once there is real traffic.
MOTIS_BASE_URL=https://api.transitous.org
MOTIS_TIMEOUT_S=30
MOTIS_MAX_CONCURRENCY=2
MOTIS_MAX_DIRECT_TIME_S=7200
MOTIS_MAX_PRE_TRANSIT_TIME_S=1800
MOTIS_CACHE_TTL_S=3600
# Haltestellen und ihre Verkehrsmittel ändern sich höchstens täglich, das
# Fußwegenetz noch seltener.
MOTIS_STOPS_CACHE_TTL_S=86400
MOTIS_MATRIX_CACHE_TTL_S=604800

# --- Umgebung / "was ist in der Nähe" (POST /api/nearby) -------------------
# Haltestellen und Bahnhöfe kommen aus demselben MOTIS und brauchen hier
# nichts. Schule, Kindergarten, Park, Spielplatz, Supermarkt und Arztpraxis
# kommen aus einem lokalen OpenStreetMap-Verzeichnis, das
#   python scripts/build_poi_index.py --download
# erzeugt. Fehlt die Datei, antwortet /api/nearby für diese Kategorien mit
# „kein Datenbestand eingerichtet“ statt mit einer leeren Liste, und
# /api/health meldet es.
# Absoluter Pfad, wenn gesetzt: ein relativer wird gegen das
# Arbeitsverzeichnis aufgelöst, und uvicorn startet je nach Befehl im
# Projektwurzelverzeichnis. Ohne Eintrag gilt backend/data/poi-sachsen.json.
# NEARBY_POI_INDEX_PATH=/srv/where2build/backend/data/poi-sachsen.json
# Serverseitige Obergrenze von one-to-many ("onetomany_max_many"). Mehr ist
# ein 422 vom Routing-Dienst.
NEARBY_MAX_CANDIDATES=128
NEARBY_MAX_TIME_S=5400
NEARBY_MAX_MATCHING_DISTANCE_M=250
NEARBY_BBOX_GRID_DEG=0.02
# Linien je Haltestelle kosten eine weitere Anfrage; nur auf Anforderung.
NEARBY_MAX_LINE_LOOKUPS=6

# --- WMS tile proxy -------------------------------------------------------
TILES_DOP_URL=https://geodienste.sachsen.de/wms_geosn_dop-rgb/guest
TILES_DOP_LAYERS=sn_dop_020
TILES_WEBATLAS_URL=https://geodienste.sachsen.de/wms_geosn_webatlas-sn/guest
TILES_ALKIS_URL=https://geodienste.sachsen.de/wms_geosn_alkis-adv/guest
# XYZ tiles are Web Mercator; set EPSG:4326 if a service rejects EPSG:3857.
TILES_CRS=EPSG:3857
TILES_CACHE_TTL_S=2592000

# --- vector basemap proxy (OpenFreeMap) -----------------------------------
# MapLibre must not have to reach the internet itself: the style is rewritten
# so every URL in it comes back through /api/basemap/, and tiles, glyphs and
# sprites travel through the same proxy. Point UPSTREAM_URL at your own tile
# server to leave OpenFreeMap behind entirely.
BASEMAP_UPSTREAM_URL=https://tiles.openfreemap.org
BASEMAP_STYLE_PATH=styles/liberty
# Path prefix the rewritten URLs point at; must match where this API is mounted.
BASEMAP_PUBLIC_PREFIX=/api/basemap
# Extra hosts whose absolute URLs are rewritten onto the proxy (JSON list). The
# upstream's own host is always rewritten; this covers a self-hosted mirror
# that still serves a style naming OpenFreeMap.
BASEMAP_REWRITE_HOSTS=["tiles.openfreemap.org"]
# Seven days. Tiles are effectively immutable; OpenFreeMap itself sends a
# ten-year max-age.
BASEMAP_CACHE_TTL_S=604800
BASEMAP_TIMEOUT_S=30

# --- extraction provider (OpenAI-compatible) ------------------------------
# No provider is hard-wired: base URL, key and model come from here.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
# openrouter | exa | parallel | native | auto
LLM_FETCH_ENGINE=openrouter
LLM_TIMEOUT_S=120
LLM_MAX_CONTENT_TOKENS=50000
