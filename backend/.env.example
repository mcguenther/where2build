# Grundstücks-Check Sachsen — backend configuration.
# Copy to .env and fill in. Every value below is a default; none has to be set
# except LLM_API_KEY, without which page extraction stays switched off.

# --- application ----------------------------------------------------------
# Browser origins allowed to call this API (JSON list). Vite dev + preview.
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
APP_CACHE_DIR=.cache
# Identifies this application to every upstream. Keep the contact address OUT
# of it: this string also goes to ALKIS, BORIS, the tile servers and the
# extraction provider, none of which asks for one.
APP_USER_AGENT=GrundstuecksCheckSachsen/0.1 (+https://example.org)
# A way of contact, appended to the User-Agent for Transitous alone — its usage
# policy requires one. Left empty, nothing is appended and nothing is sent.
APP_CONTACT=kontakt@example.org
APP_HTTP_TIMEOUT_S=30
# Wie viele eigene Reverse Proxys vor diesem Prozess stehen. 0 heißt keiner,
# und dann wird X-Forwarded-For gar nicht gelesen: die Kopfzeile kann jeder
# Browser selbst schreiben, und wer sie ungeprüft glaubt, lässt fremde
# Kontingente verbrauchen oder das eigene umgehen. Das mitgelieferte
# docker compose reicht /api durch nginx, dort gehört eine 1 hin; ein
# nacktes uvicorn bleibt bei 0. Gelesen wird von rechts, denn nginx hängt
# die Gegenstelle an, die es selbst gesehen hat.
APP_PROXY_HOPS=0

# --- ALKIS (GeoSN, cadastral parcels) -------------------------------------
ALKIS_WFS_URL=https://geodienste.sachsen.de/aaa/public_alkis/vereinf/wfs
ALKIS_VERSION=2.0.0
ALKIS_SRID=25833
ALKIS_MAX_FEATURES=200
ALKIS_POINT_BUFFER_M=1.0
ALKIS_CACHE_TTL_S=604800

# --- BORIS (land reference values) ----------------------------------------
# The endpoint carries the reference year; re-check it once a year.
BORIS_WMS_URL=https://www.landesvermessung.sachsen.de/fp/httpproxy/svcdep/wms/boris_2026
BORIS_LAYER=brw_2026
BORIS_CACHE_TTL_S=2592000

# --- MOTIS / Transitous (routing, geocoding) ------------------------------
# The public instance is for the prototype only: open source, non-commercial,
# light load. Point this at your own MOTIS once there is real traffic.
MOTIS_BASE_URL=https://api.transitous.org
MOTIS_TIMEOUT_S=30
MOTIS_MAX_CONCURRENCY=2
MOTIS_MAX_DIRECT_TIME_S=7200
MOTIS_MAX_PRE_TRANSIT_TIME_S=1800
MOTIS_CACHE_TTL_S=3600
# Haltestellen und ihre Verkehrsmittel ändern sich höchstens täglich, das
# Fußwegenetz noch seltener.
MOTIS_STOPS_CACHE_TTL_S=86400
MOTIS_MATRIX_CACHE_TTL_S=604800

# --- Umgebung / "was ist in der Nähe" (POST /api/nearby) -------------------
# Haltestellen und Bahnhöfe kommen aus demselben MOTIS und brauchen hier
# nichts. Schule, Kindergarten, Park, Spielplatz, Supermarkt und Arztpraxis
# kommen aus einem lokalen OpenStreetMap-Verzeichnis, das
#   python scripts/build_poi_index.py --download
# erzeugt. Fehlt die Datei, antwortet /api/nearby für diese Kategorien mit
# „kein Datenbestand eingerichtet“ statt mit einer leeren Liste, und
# /api/health meldet es.
# Absoluter Pfad, wenn gesetzt: ein relativer wird gegen das
# Arbeitsverzeichnis aufgelöst, und uvicorn startet je nach Befehl im
# Projektwurzelverzeichnis. Ohne Eintrag gilt backend/data/poi-sachsen.json.
# NEARBY_POI_INDEX_PATH=/srv/where2build/backend/data/poi-sachsen.json
# Serverseitige Obergrenze von one-to-many ("onetomany_max_many"). Mehr ist
# ein 422 vom Routing-Dienst.
NEARBY_MAX_CANDIDATES=128
NEARBY_MAX_TIME_S=5400
NEARBY_MAX_MATCHING_DISTANCE_M=250
NEARBY_BBOX_GRID_DEG=0.02
# Linien je Haltestelle kosten eine weitere Anfrage; nur auf Anforderung.
NEARBY_MAX_LINE_LOOKUPS=6

# --- Overpass (Live-Abfrage statt lokalem Verzeichnis) --------------------
# Notlösung für den Prototyp: Ohne gebautes Verzeichnis werden Schule,
# Kindergarten, Park, Spielplatz, Supermarkt und Arztpraxis bei Bedarf live
# über Overpass geholt — eine Abfrage je Anfrage, Antwort 30 Tage im Cache.
# Standardmäßig aus, und das mit Absicht: Das Overpass-Handbuch nennt „setting
# up an app for more than just OSM mappers and relying on the public instances
# as backend“ ausdrücklich als problematisches Verhalten und nennt als
# Richtwert rund 10 000 Anfragen und 1 GB pro Tag je IP-Adresse. Ein
# Einzelnutzer-Prototyp liegt weit darunter; eine Anwendung mit Nutzern nicht.
# Der Dauerbetrieb läuft über ein eigenes Verzeichnis
# (python scripts/build_poi_index.py --download) oder eine eigene Instanz.
OVERPASS_ENABLED=false
# Eigene Instanz: hier eintragen, sonst ändert sich nichts weiter.
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Steht als [timeout:N] in der Abfrage selbst; danach antwortet der Dienst mit
# „runtime error“ statt mit Daten.
OVERPASS_QUERY_TIMEOUT_S=25
# Länger als die Abfragezeit: Anfragen warten laut Handbuch bis zu 15 s auf
# einen freien Slot, bevor sie überhaupt starten.
OVERPASS_TIMEOUT_S=60
# Ein Grundstück zieht nicht um, und seine Umgebung ändert sich im Monatstakt —
# dieselbe Frische, die ein vierteljährlich gebautes Verzeichnis hätte.
OVERPASS_CACHE_TTL_S=2592000
# Die öffentlichen Instanzen vergeben Ausführungs-Slots je IP-Adresse.
OVERPASS_MAX_CONCURRENCY=1
# Rundung für den Cache: Mittelpunkt auf drei Nachkommastellen (~110 m),
# Umkreis auf das nächste Vielfache, plus Sicherheitszuschlag.
OVERPASS_RADIUS_STEP_M=1000
OVERPASS_ORIGIN_PRECISION=3
OVERPASS_ORIGIN_MARGIN_M=200

# --- WMS tile proxy -------------------------------------------------------
TILES_DOP_URL=https://geodienste.sachsen.de/wms_geosn_dop-rgb/guest
TILES_DOP_LAYERS=sn_dop_020
TILES_WEBATLAS_URL=https://geodienste.sachsen.de/wms_geosn_webatlas-sn/guest
TILES_ALKIS_URL=https://geodienste.sachsen.de/wms_geosn_alkis-adv/guest
# XYZ tiles are Web Mercator; set EPSG:4326 if a service rejects EPSG:3857.
TILES_CRS=EPSG:3857
TILES_CACHE_TTL_S=2592000

# --- vector basemap proxy (OpenFreeMap) -----------------------------------
# MapLibre must not have to reach the internet itself: the style is rewritten
# so every URL in it comes back through /api/basemap/, and tiles, glyphs and
# sprites travel through the same proxy. Point UPSTREAM_URL at your own tile
# server to leave OpenFreeMap behind entirely.
BASEMAP_UPSTREAM_URL=https://tiles.openfreemap.org
BASEMAP_STYLE_PATH=styles/liberty
# Path prefix the rewritten URLs point at; must match where this API is mounted.
BASEMAP_PUBLIC_PREFIX=/api/basemap
# Extra hosts whose absolute URLs are rewritten onto the proxy (JSON list). The
# upstream's own host is always rewritten; this covers a self-hosted mirror
# that still serves a style naming OpenFreeMap.
BASEMAP_REWRITE_HOSTS=["tiles.openfreemap.org"]
# Seven days. Tiles are effectively immutable; OpenFreeMap itself sends a
# ten-year max-age.
BASEMAP_CACHE_TTL_S=604800
BASEMAP_TIMEOUT_S=30

# --- extraction provider (OpenAI-compatible) ------------------------------
# No provider is hard-wired: base URL, key and model come from here.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
# openrouter | exa | parallel | native | auto
LLM_FETCH_ENGINE=openrouter
LLM_TIMEOUT_S=120
LLM_MAX_CONTENT_TOKENS=50000

# --- Anmeldung über OpenID Connect (optional) ------------------------------
# Ohne OIDC_ISSUER gibt es keine Anmeldung, und das ist ein vollständiger
# Zustand: die Anwendung lässt sich ohne Konto benutzen, die Grundstücke
# bleiben im Browser, /api/auth/me antwortet „eingerichtet: false“ und
# /api/health sagt, was fehlt. Eine Entwicklungsumgebung braucht also keinen
# Identity-Provider.
#
# Der Anbieter ist frei wählbar: selbst gehostetes Authentik, Keycloak, Google.
# Die Endpunkte werden nicht geraten, sondern aus
#   <OIDC_ISSUER>/.well-known/openid-configuration
# gelesen (eine Stunde zwischengespeichert).
#
# Als Redirect-URI muss beim Anbieter <öffentliche Adresse>/api/auth/callback
# eingetragen sein.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# „openid“ authentifiziert, „profile“ liefert den Anzeigenamen. Bewusst ohne
# „email“: das Projekt speichert keine Kontaktdaten, und was nie angefordert
# wird, kann auch nicht versehentlich gespeichert werden.
OIDC_SCOPES=openid profile
# Signiert das Sitzungscookie (HMAC-SHA256). Kein Standardwert, denn ein
# mitgelieferter wäre öffentlich bekannt und jede Sitzung fälschbar. Erzeugen
# mit: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Wird der Wert gewechselt, sind alle bestehenden Sitzungen ungültig.
OIDC_SESSION_SECRET=
# Nur für einen lokalen Server ohne TLS auf false setzen. Ein Sitzungscookie
# ohne „Secure“ geht bei jeder http-Anfrage an denselben Host mit.
OIDC_COOKIE_SECURE=true
# Öffentliche Adresse dieser Anwendung, z. B. https://where2build.example.
# Leer heißt: aus der Anfrage ableiten. Das stimmt beim lokalen Server und
# stimmt nicht hinter einem Reverse Proxy, der TLS terminiert: dort kommt die
# Anfrage als http an, und die daraus gebaute redirect_uri passt nicht mehr zu
# der beim Anbieter eingetragenen.
OIDC_PUBLIC_BASE_URL=
# Gültigkeit der Sitzung (14 Tage). Es wird kein Refresh-Token aufbewahrt, das
# ist also schlicht die Zeit bis zur nächsten Anmeldung.
OIDC_SESSION_TTL_S=1209600
# Wie lange der Weg von /api/auth/login bis /api/auth/callback dauern darf.
OIDC_LOGIN_TTL_S=600
OIDC_DISCOVERY_CACHE_TTL_S=3600
OIDC_TIMEOUT_S=15

# --- Abrufkontingent je Konto ----------------------------------------------
# Dieses Backend beantwortet nichts aus eigenem Bestand: jede Anfrage hier wird
# eine Anfrage an einen fremden Dienst (Kataster, BORIS, LUIS, UBA, Transitous,
# gegebenenfalls Overpass). Als Einzelplatz-Prototyp war das unstrittig; ein
# Betrieb mit Konten ist genau das, was die Overpass-Politik mit „relying on
# the public instances as backend“ meint, und Transitous wird ehrenamtlich
# betrieben. Deshalb bekommt jedes Konto eine Obergrenze.
#
# Angemeldet zählt das Konto, abgemeldet die Gegenstelle (siehe
# APP_PROXY_HOPS). Über der Grenze antwortet der Server 429 mit einem deutschen
# Satz und Retry-After. Gezählt wird im Arbeitsspeicher des Prozesses, ohne
# Redis: bei mehreren Arbeitsprozessen gilt die Grenze je Prozess.
#
# Für den Einzelplatz auf false setzen. Auch der Screenshot-Lauf
# (node scripts/screenshots.mjs) fährt die ganze Anwendung in einem Zug durch.
RATELIMIT_ENABLED=true
RATELIMIT_WINDOW_S=3600
# Alles, was einen fremden Dienst befragt. Die Zahl ist gegriffen: ein
# vollständig geprüftes Grundstück sind gut ein Dutzend Abrufe, 600 je Stunde
# sind also rund fünfzig Grundstücke in einer Stunde.
RATELIMIT_SERVICE_CALLS=600
# Kartenkacheln und Vektor-Hintergrundkarte, mit eigenem, weitem Kontingent:
# ein Bildschirm sind Dutzende davon, und der gemeinsame Plattencache deckt
# jede Wiederholung ab.
RATELIMIT_MAP_TILES=6000
# Wie viele Zugänge gleichzeitig gezählt werden. Der am längsten nicht gesehene
# fällt zuerst heraus, damit die Buchführung nicht unbegrenzt wächst.
RATELIMIT_MAX_CLIENTS=20000

# --- Serverspeicher für Konten (optional) ----------------------------------
# Ohne DATABASE_URL gibt es keinen Serverspeicher, und das ist ein
# vollständiger Zustand: die Grundstücke bleiben in dem Browser, in dem sie
# angelegt wurden, /api/plots und /api/settings antworten 503 mit einem
# deutschen Satz, und /api/health sagt, was fehlt. Beim Start wird dann keine
# Verbindung versucht; eine Entwicklungsumgebung braucht also kein Postgres.
#
# Ist die Variable gesetzt, legt der Server die drei Tabellen beim Start selbst
# an (app/schema.sql, CREATE TABLE IF NOT EXISTS). Ein echtes
# Migrationswerkzeug ist fällig, bevor sich zum ersten Mal eine Spalte ändert,
# nicht vorher. Ist die Datenbank konfiguriert, aber nicht erreichbar, startet
# der Server trotzdem: alles andere (Flurstücke, Kacheln, Routing, Suche)
# funktioniert ohne sie, und die Kontoabrufe antworten 502.
#
# Gespeichert wird pro Konto: die Grundstücke (eine Zeile je Grundstück) und
# der Rest des Dokuments (Haustypen, Ziele, Auswahl) in einer Zeile. Der Inhalt
# ist das Dokument des Frontends, unverändert als jsonb; der Server liest nicht
# hinein. Vom Konto selbst liegen nur Issuer, Subject und Anzeigename dort,
# keine Kontaktdaten. Das Konto entsteht beim ersten Speichern, nicht beim
# Anmelden.
#
# Der Name ist bewusst ohne Präfix: so heißt die Variable bei jedem Hoster.
DATABASE_URL=
# Grenzen je Konto. Die Zahlen sind gegriffen, nicht gemessen: sie verhindern,
# dass ein Konto die Platte füllt. Überschreitung antwortet 409 (zu viele
# Grundstücke) bzw. 413 (Dokument zu groß), jeweils mit einem Satz, der die
# Grenze nennt.
STORAGE_MAX_PLOTS_PER_ACCOUNT=200
STORAGE_MAX_DOCUMENT_BYTES=2097152
# Verbindungspool. Klein gehalten: jede Anfrage hält eine Verbindung für ein
# oder zwei Anweisungen.
STORAGE_POOL_MIN_SIZE=1
STORAGE_POOL_MAX_SIZE=8
# Gilt für den Verbindungsaufbau und für jede einzelne Anweisung.
STORAGE_TIMEOUT_S=10
#
# Für die Tests: TEST_DATABASE_URL zeigt auf eine Wegwerf-Datenbank. Ohne die
# Variable überspringen sich die Speicher-Tests selbst, so wie die
# Bilderkennungs-Tests ohne Tesseract. Achtung, die Tabellen werden zwischen
# den Tests gelöscht:
#   TEST_DATABASE_URL=postgresql://where2build@127.0.0.1:5433/where2build \
#       backend/.venv/bin/python -m pytest backend/tests -q

# ----------------------------------------------------------------------------
# Verwaltung (/verwaltung)
# ----------------------------------------------------------------------------
# Wer den Bereich öffnen darf. Eingetragen werden *Kennungen* — die 32 Zeichen,
# die /api/auth/me meldet und die Kontoseite anzeigt —, niemals Mailadressen:
# diese Anwendung erhebt keine. Die Liste ist der Anfang und nicht die ganze
# Rechtevergabe: alle weiteren Verwalter werden in der Oberfläche ernannt, und
# das Kennzeichen dafür steht in der Datenbank. Eine Kennung weist niemanden
# aus, sie benennt nur — wer sich nicht als diese Person anmelden kann, gewinnt
# durch sie nichts. Und sie ist das, was ein geleertes `users` überlebt.
ADMIN_ACCOUNTS=
# Wie oft die Zähler aus dem Arbeitsspeicher in die Datenbank geschrieben und
# die Sperren zurückgelesen werden. Kurz genug, dass „letzte Stunde" aktuell
# ist und eine Sperre die anderen Arbeitsprozesse schnell erreicht.
ADMIN_FLUSH_S=30
# Wie lange Zähler, Fehler und Prüfprotokoll aufgehoben werden.
ADMIN_RETENTION_DAYS=90
# Die kurze Bremse. Das Stundenkontingent unten kann nichts aufhalten: wenn die
# Stunde sichtbar ist, ist sie vorbei. Wer mehr als ADMIN_BURST_CALLS Anfragen
# in ADMIN_BURST_WINDOW_S Sekunden stellt, wird sofort gesperrt — für
# ADMIN_AUTO_BLOCK_MINUTES Minuten, und die Sperre endet von selbst.
# Kartenkacheln zählen für das Konto, aber nicht in dieses Fenster: ein
# Kartenausschnitt sind Dutzende davon.
ADMIN_BURST_CALLS=300
ADMIN_BURST_WINDOW_S=300
ADMIN_AUTO_BLOCK_MINUTES=60
# Wie viele Fehler dieser Prozess selbst vorhält. Ohne Datenbank ist das alles,
# was der Verwaltungsbereich über Fehler sagen kann — und besser als nichts.
ADMIN_ERROR_BUFFER=500
